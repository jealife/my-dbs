NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Origines autorisées pour le CORS (séparées par des virgules, sans espace)
# En production : ALLOWED_ORIGINS=https://mydbs.fr,https://app.mydbs.fr
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMTP — requis pour l'envoi d'emails (ne jamais committer avec de vraies valeurs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@mydbs.fr
SMTP_PASS=

# URL backend côté serveur uniquement (non exposée au client)
BACKEND_BASE_URL=http://localhost:8080